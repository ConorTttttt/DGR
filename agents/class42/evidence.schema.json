{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ConorTttttt/DGR/blob/agent5/class42-adr2025-evidence-rules/agents/class42/evidence.schema.json",
  "title": "Provisional ADR 2025 Class 4.2 test-record input; upstream attestation NOT supplied by this schema",
  "type": "object",
  "required": [
    "assessment_id",
    "evidence_id",
    "report_id",
    "sample_id",
    "pathway",
    "physical_state",
    "test_method",
    "is_mixture",
    "shipment_formulation_verified",
    "report_scope_verified",
    "protocol_conformant"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "pathway": {
      "enum": [
        "pyrophoric_solid",
        "pyrophoric_liquid",
        "self_heating"
      ]
    },
    "physical_state": {
      "enum": [
        "solid",
        "liquid"
      ]
    },
    "test_method": {
      "enum": [
        "N.2",
        "N.3",
        "N.4"
      ]
    },
    "sample_form": {
      "enum": [
        "powdery",
        "powder",
        "granular",
        "other"
      ]
    },
    "is_article": {
      "type": "boolean"
    },
    "is_mixture": {
      "type": "boolean"
    },
    "mixture_composition_verified": {
      "type": "boolean"
    },
    "shipment_formulation_verified": {
      "type": "boolean"
    },
    "report_scope_verified": {
      "type": "boolean"
    },
    "protocol_conformant": {
      "type": "boolean"
    },
    "conflicting_reports": {
      "type": "boolean"
    },
    "more_severe_experience": {
      "type": "boolean"
    },
    "organometallic": {
      "type": "boolean"
    },
    "named_entry_un": {
      "type": "string",
      "pattern": "^[0-9]{4}$"
    },
    "named_entry_verified": {
      "type": "boolean"
    },
    "oxidizing_confirmed": {
      "type": "boolean"
    },
    "class1_requirements_met": {
      "type": "boolean"
    },
    "package_volume_l": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Volume of each actual package, not total consignment; 1 m3 = 1000 L"
    },
    "competing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "evidence_id",
          "verified"
        ],
        "properties": {
          "class": {
            "enum": [
              "1",
              "3",
              "4.1",
              "4.3",
              "5.1",
              "6.1",
              "8"
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "verified": {
            "const": true
          }
        }
      }
    },
    "trials": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "quantity_ml",
          "drop_about_1m_verified",
          "noncombustible_surface_verified",
          "ignites_during_fall",
          "ignition_seconds"
        ],
        "properties": {
          "quantity_ml": {
            "type": "number",
            "minimum": 1,
            "maximum": 2
          },
          "drop_about_1m_verified": {
            "const": true
          },
          "noncombustible_surface_verified": {
            "const": true
          },
          "ignites_during_fall": {
            "type": "boolean"
          },
          "ignition_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "observed_full_5min": {
            "type": "boolean"
          }
        }
      }
    },
    "carrier_trials": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "inert_carrier_verified",
          "ignition_seconds"
        ],
        "properties": {
          "inert_carrier_verified": {
            "const": true
          },
          "ignition_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "observed_full_5min": {
            "type": "boolean"
          }
        }
      }
    },
    "filter_trials": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "ignition_seconds",
          "charring_seconds",
          "temperature_c",
          "humidity_pct",
          "fresh_dry_indented_whatman3_verified"
        ],
        "properties": {
          "ignition_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "charring_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "temperature_c": {
            "type": "number",
            "minimum": 23,
            "maximum": 27
          },
          "humidity_pct": {
            "type": "number",
            "minimum": 45,
            "maximum": 55
          },
          "fresh_dry_indented_whatman3_verified": {
            "const": true
          },
          "observed_full_5min": {
            "type": "boolean"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cube_mm",
          "setpoint_c",
          "oven_actual_c",
          "spontaneous_ignition",
          "continuous_record_verified"
        ],
        "properties": {
          "cube_mm": {
            "enum": [
              25,
              100
            ]
          },
          "setpoint_c": {
            "enum": [
              100,
              120,
              140
            ]
          },
          "oven_actual_c": {
            "type": "number",
            "description": "Actual recorded oven temp, within ±2°C of setpoint; cross-field check is in code"
          },
          "max_sample_c": {
            "type": "number",
            "description": "Maximum measured sample temp from continuous record within 24 h"
          },
          "spontaneous_ignition": {
            "type": "boolean"
          },
          "event_within_24h": {
            "type": "boolean"
          },
          "observed_full_24h": {
            "type": "boolean"
          },
          "continuous_record_verified": {
            "const": true
          }
        }
      }
    },
    "report_metadata": {
      "type": "object",
      "description": "Traceable metadata; verify upstream rather than treating strings as trusted",
      "properties": {
        "laboratory": {
          "type": "string"
        },
        "report_date": {
          "type": "string",
          "format": "date"
        },
        "signer": {
          "type": "string"
        },
        "apparatus_log_ref": {
          "type": "string"
        },
        "calibration_ref": {
          "type": "string"
        },
        "raw_data_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "commercial_grade": {
          "type": "string"
        },
        "composition_mass_fractions": {
          "type": "array"
        },
        "diluent_or_stabilizer": {
          "type": "string"
        },
        "test_method_report_ref": {
          "type": "string"
        },
        "package_configuration_ref": {
          "type": "string"
        },
        "sampling_protocol_ref": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "pathway": {
            "const": "pyrophoric_solid"
          }
        },
        "required": [
          "pathway"
        ]
      },
      "then": {
        "properties": {
          "physical_state": {
            "const": "solid"
          },
          "test_method": {
            "const": "N.2"
          },
          "sample_form": {
            "const": "powdery"
          }
        },
        "required": [
          "trials",
          "sample_form"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "pathway": {
            "const": "pyrophoric_liquid"
          }
        },
        "required": [
          "pathway"
        ]
      },
      "then": {
        "properties": {
          "physical_state": {
            "const": "liquid"
          },
          "test_method": {
            "const": "N.3"
          }
        },
        "required": [
          "carrier_trials"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "pathway": {
            "const": "self_heating"
          }
        },
        "required": [
          "pathway"
        ]
      },
      "then": {
        "properties": {
          "test_method": {
            "const": "N.4"
          },
          "sample_form": {
            "enum": [
              "powder",
              "granular"
            ]
          }
        },
        "required": [
          "runs",
          "sample_form"
        ]
      }
    }
  ],
  "description": "Absence of data is unknown, never an implicit negative; no CLP/GHS mapping. False attestations are invalid evidence, not negative tests."
}
