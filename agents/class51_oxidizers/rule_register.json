    },
    {
      "path": "composition.chemicalIdentity",
      "type": "normalized verified chemical identity",
      "mandatory": "when material matches specific prohibited identity"
    },
    {
      "path": "composition.stabilized",
      "type": "boolean",
      "mandatory": "hydrogen peroxide neat/aqueous"
    },
    {
      "path": "composition.massPercent",
