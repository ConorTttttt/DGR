      "mandatory": "aqueous hydrogen peroxide and perchloric/chloric acid solutions"
    },
    {
      "path": "composition.otherLiquidThanWater",
      "type": "boolean",
      "mandatory": "perchloric/chloric acid solution"
    },
    {
      "path": "composition.combustibleMassPercent",
      "type": "% by mass including organic carbon equivalence",
      "mandatory": "ammonium nitrate (non-Section39 fertilizer route)"
    }
