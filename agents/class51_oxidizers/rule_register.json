  "manual_protocol_constraints": [
    {
      "method": "O.1",
      "clauses": [
        "34.4.1.2.1",
        "34.4.1.2.2",
        "34.4.1.2.6",
        "34.4.1.3.1-34.4.1.3.3"
      ],
      "reference": "potassium bromate, 0.15-0.30 mm dried 65 C >=12 h; cellulose dried 105 C >=4 h, <0.5% moisture",
      "conditions": "30.0 +/-0.1 g mixtures, 20 +/-5 C, five runs per mixture/reference; 4:1 and 1:1 sample:cellulose; >10% particles <500 um/friable and coated-sieved protocol."
    },
    {
      "method": "O.2",
      "clauses": [
        "34.4.2.2.5-34.4.2.2.7",
        "34.4.2.3.1-34.4.2.3.2"
      ],
      "reference": "50% perchloric acid, 40% aqueous sodium chlorate, 65% aqueous nitric acid",
      "conditions": "2.50 +/-0.01 g liquid + 2.50 +/-0.01 g dried cellulose; mixture 1:1 mass; five pressure trials; 690-to-2070 kPa gauge; saturated solutions prepared at 20 C; document concentration."
    },
    {
      "method": "O.3",
      "clauses": [
        "34.4.3.2.1-34.4.3.2.3",
        "34.4.3.4",
        "34.4.3.5.2-34.4.3.5.6"
      ],
      "reference": "calcium peroxide concentration 75 +/-1.0%, specified purity/particle distribution; cellulose dried and <0.5% moisture",
      "conditions": "30.0 +/-0.1 g mixtures, 20 +/-5 C, RH <60%, mass-loss 20-80%, BR=0.6*m(cellulose)/t(20-80), five valid runs, each R^2 >=0.90, relative std dev <=20%; suspect false positives need inert controls."
    }
  ],
  "rules": [
    {
      "id": "51-001",
      "source": {
        "document": "ECE/TRANS/352",
        "edition": "ADR 2025",
        "language": "en",
        "volume": "I"
      },
      "clause": "2.2.51.1.1",
      "kind": "decision",
      "summary": "Class definition",
      "logic": "Substance may yield oxygen and cause/contribute combustion; no CLP auto-conversion.",
      "status": "provisional_expert_review_required"
    },
    {
      "id": "51-002",
      "source": {
        "document": "ECE/TRANS/352",
        "edition": "ADR 2025",
        "language": "en",
        "volume": "I"
      },
      "clause": "2.2.51.1.2",
      "kind": "decision",
      "summary": "Classification codes",
      "logic": "O1 O2 O3 OF OS OW OT1 OT2 OC1 OC2 OTC; refer precedence/entry resolution.",
      "status": "provisional_expert_review_required"
    },
    {
      "id": "51-003",
      "source": {
        "document": "ECE/TRANS/352",
        "edition": "ADR 2025",
        "language": "en",
        "volume": "I"
      },
      "clause": "2.2.51.1.3",
      "kind": "decision",
      "summary": "Unnamed entry, tests, experience",
      "logic": "Test O.1/O.3/O.2 or MTC 39; known experience supersedes divergent tests.",
      "status": "provisional_expert_review_required"
    },
    {
      "id": "51-004",
      "source": {
        "document": "ECE/TRANS/352",
        "edition": "ADR 2025",
        "language": "en",
        "volume": "I"
      },
      "clause": "2.2.51.1.4",
      "kind": "decision",
      "summary": "Mixtures and solutions",
      "logic": "Use mixture's actual hazard; require representative formulation evidence and 2.1.3 resolution.",
      "status": "provisional_expert_review_required"
    },
    {
      "id": "51-005",
      "source": {
        "document": "ECE/TRANS/352",
        "edition": "ADR 2025",
        "language": "en",
        "volume": "I"
      },
      "clause": "2.2.51.1.5",
      "kind": "decision",
      "summary": "Named substance test exemption possibility",
      "logic": "Named entries not negated automatically; integrator must confirm classification applicability.",
      "status": "provisional_expert_review_required"
    },
    {
      "id": "51-006",
      "source": {
        "document": "ECE/TRANS/352",
        "edition": "ADR 2025",
        "language": "en",
        "volume": "I"
      },
      "clause": "2.2.51.1.6(a)",
      "kind": "decision",
      "summary": "O.1 solid class criterion",
      "logic": "At 4:1 OR 1:1 sample-to-cellulose: ignites/burns OR mean time <= KBrO3/cellulose 3:7.",
      "status": "provisional_expert_review_required"
    },
    {
      "id": "51-007",
