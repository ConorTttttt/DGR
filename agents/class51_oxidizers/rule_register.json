        "language": "en",
        "volume": "I"
      },
      "clause": "2.2.51.1.6(b)",
      "kind": "decision",
      "summary": "O.3 solid class criterion",
      "logic": "At 4:1 OR 1:1 mean rate >= CaO2/cellulose 1:2.",
      "status": "provisional_expert_review_required"
    },
    {
      "id": "51-008",
      "source": {
        "document": "ECE/TRANS/352",
