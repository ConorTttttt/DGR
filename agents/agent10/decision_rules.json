{
  "schema_version": "0.1.0",
  "status": "provisional_unreviewed",
  "authority": {
    "edition": "ADR 2025",
    "document": "ECE/TRANS/352 (Vol.I)",
    "clauses": "2.2.62.1–2.2.62.3;3.2.1;3.3.1",
    "language": "English"
  },
  "implementation": "agents/agent10/class62.mjs",
  "input_contract": "agents/agent10/README.md",
  "policy": "Rules are an auditable decision manifest; executable predicates are in class62.mjs. No final SDS Section 14 decisions.",
  "order": [
    "mode_guard",
    "kind_gate",
    "contradiction_gate",
    "live_animal_or_other_class_referrals",
    "validated_inactivation",
    "specimen_specific",
    "device_specific",
    "biological_product_specific",
    "waste_specific",
    "natural_level",
    "general_pathogen_and_category",
    "Table_A_and_global_integration"
  ],
  "rules": [
    {
      "priority": 1,
      "id": "62-SCOPE",
      "citation": "2.2.62.1.1",
      "condition_description": "Definition of known or reasonably expected pathogens, including prions; GMM/GMOs, biological products, specimens and infected animals considered only on relevant criteria",
      "evidence_requirements": "infectious-substance evidence; source and form",
      "effect": "class determination",
      "limit": "Scope gate",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 2,
      "id": "62-SUBDIVISIONS",
      "citation": "2.2.62.1.2",
      "condition_description": "I1 humans, I2 animals only, I3 clinical waste, I4 biological substances",
      "evidence_requirements": "context, host population",
      "effect": "classification code candidate",
      "limit": "Table A confirmation",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 3,
      "id": "62-DEFINITIONS",
      "citation": "2.2.62.1.3",
      "condition_description": "Biological products, cultures, medical or clinical wastes, and patient specimens are separately defined",
      "evidence_requirements": "actual material purpose, propagation, origin",
      "effect": "context routing",
      "limit": "Patient specimens are not automatically cultures",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 4,
      "id": "62-ENTRY-ROUTING",
      "citation": "2.2.62.1.4",
      "condition_description": "Five entry families 2814, 2900, 3291, 3373, 3549 identified as appropriate",
      "evidence_requirements": "category and context",
      "effect": "candidate only",
      "limit": "No final UN assignment",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 5,
      "id": "62-CATA",
      "citation": "2.2.62.1.4.1",
      "condition_description": "Exposure to transported form capable of permanent disability, life-threatening or fatal disease in otherwise healthy human/animal",
      "evidence_requirements": "severity, exposure form, professional/clinical evidence",
      "effect": "Category A candidate",
      "limit": "Table indicative, not exhaustive",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 6,
      "id": "62-CATA-TARGET",
      "citation": "2.2.62.1.4.1(a)-(b)",
      "condition_description": "Human/both A -> 2814; animals only A -> 2900; source medical history, symptoms, endemic conditions or professional judgement",
      "evidence_requirements": "host effects and source circumstances",
      "effect": "2814 or 2900 candidate",
      "limit": "Technical name gate SP318",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 7,
      "id": "62-CATA-DOUBT",
      "citation": "2.2.62.1.4.1 Note 2",
      "condition_description": "Documented doubt about whether material meets Category A criteria is resolved into A; list not exhaustive",
      "evidence_requirements": "recorded professional judgement; basis",
      "effect": "Category A candidate",
      "limit": "Missing facts alone are not asserted doubt",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 8,
      "id": "62-CATA-INDICATIVE",
      "citation": "2.2.62.1.4.1 indicative table and footnote a",
      "condition_description": "Example organisms may have cultures-only condition; three diagnostic/clinical culture examples may qualify as B",
      "evidence_requirements": "organism identity, culture form, intended use, expert decision",
      "effect": "evidence aid only",
      "limit": "No hardcoded automatic category from organism name",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 9,
      "id": "62-CATB",
      "citation": "2.2.62.1.4.2",
      "condition_description": "Infectious substances not meeting Category A -> Category B / 3373",
      "evidence_requirements": "verified infection, negative Category A criteria",
      "effect": "3373 candidate",
      "limit": "SP319 requires P650 packaging and marking for relief",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 10,
      "id": "62-NEGATIVE",
      "citation": "2.2.62.1.5.1",
      "condition_description": "Proved absent infectious substances or unlikely to cause disease",
      "evidence_requirements": "negative determination and provenance",
      "effect": "conditional non-subject",
      "limit": "Check other classes",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 11,
      "id": "62-NONPATHOGENIC",
      "citation": "2.2.62.1.5.2",
      "condition_description": "Confirmed nonpathogenic microorganisms",
      "evidence_requirements": "nonpathogenicity support",
      "effect": "conditional non-subject",
      "limit": "Check other classes",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 12,
      "id": "62-INACTIVATED",
      "citation": "2.2.62.1.5.3",
      "condition_description": "Inactivation/neutralisation so pathogens no longer pose health risk; drained medical equipment note",
      "evidence_requirements": "validated process or drained state",
      "effect": "conditional non-subject",
      "limit": "Check other classes",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 13,
      "id": "62-NATURAL",
      "citation": "2.2.62.1.5.4",
      "condition_description": "Naturally occurring concentration plus no significant infection risk",
      "evidence_requirements": "concentration context and risk assessment",
      "effect": "conditional non-subject",
      "limit": "No fabricated concentration threshold",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 14,
      "id": "62-DRIED",
      "citation": "2.2.62.1.5.5",
      "condition_description": "Blood drop dried on absorbent material",
      "evidence_requirements": "sample form and evidence",
      "effect": "conditional non-subject",
      "limit": "Not all blood specimens",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 15,
      "id": "62-FOBT",
      "citation": "2.2.62.1.5.6",
      "condition_description": "Faecal occult blood screening samples",
      "evidence_requirements": "sample purpose",
      "effect": "conditional non-subject",
      "limit": "Not all faecal samples",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 16,
      "id": "62-TRANSFUSION",
      "citation": "2.2.62.1.5.7",
      "condition_description": "Qualifying blood/components, tissue/organs and samples for transfusion/transplant purposes",
      "evidence_requirements": "documented specific purpose",
      "effect": "conditional non-subject",
      "limit": "Not generic research blood",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 17,
      "id": "62-MINIMAL",
      "citation": "2.2.62.1.5.8;Note 1",
      "condition_description": "Minimal likelihood of pathogens determined by professional judgement, leak-preventing package and exact mark",
      "evidence_requirements": "professional basis; source history/endemic data; packaging",
      "effect": "conditional exemption if proven",
      "limit": "Unknown risk cannot be called minimal",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 18,
      "id": "62-MINIMAL-PACK",
      "citation": "2.2.62.1.5.8(a)-(c)",
      "condition_description": "Deemed-compliant tripack: leakproof primary+secondary, adequate outer >=100x100mm, absorbent for liquids, fragile separation",
      "evidence_requirements": "dimensions in mm; liquid/fragility details; packaging proof; mark",
      "effect": "package gate",
      "limit": "Alternative leakage-proof design needs expert review",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 19,
      "id": "62-MINIMAL-AIR",
      "citation": "2.2.62.1.5.8 Note 2",
      "condition_description": "For air transport packaging described in (a)-(c) required",
      "evidence_requirements": "mode AIR",
      "effect": "mode-dependent referral",
      "limit": "No ICAO/IATA classification from ADR alone",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 20,
      "id": "62-DEVICE",
      "citation": "2.2.62.1.5.9",
      "condition_description": "Used devices sent for listed purposes may receive limited-provisions relief if no excluded Category A/waste/other class and packaging conditions met",
      "evidence_requirements": "purpose; hazard-negative checks; 6.1.4/6.6.4; 4.1.1.1-2; drop 1.2m; mark",
      "effect": "limited-provisions exemption",
      "limit": "Not unconditional non-dangerous",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 21,
      "id": "62-BIO-A",
      "citation": "2.2.62.1.9(a)",
      "condition_description": "Qualifying nationally authority-controlled biological products for final packaging/distribution and personal healthcare not subject",
      "evidence_requirements": "national authority confirmation, packaging, intended use, transport purpose",
      "effect": "conditional non-subject",
      "limit": "Local authority limits per note",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 22,
      "id": "62-BIO-B",
      "citation": "2.2.62.1.9(b)",
      "condition_description": "Other infectious biological products evaluated by Category A/B",
      "evidence_requirements": "infectious state and severity evidence",
      "effect": "2814/2900/3373 candidate",
      "limit": "Not every medicine or vaccine is exempt",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 23,
      "id": "62-GMO",
      "citation": "2.2.62.1.10",
      "condition_description": "Noninfectious genetically modified microorganisms referred to 2.2.9",
      "evidence_requirements": "absence of Class6.2 infection evidence",
      "effect": "refer other class",
      "limit": "No final Class9 assignment",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 24,
      "id": "62-WASTE-A",
      "citation": "2.2.62.1.11.1(a)",
      "condition_description": "Category A waste -> 2814/2900 or optionally eligible 3549; 3549 excludes liquid and bio-research waste",
      "evidence_requirements": "Category A evidence, species, waste form/origin/purpose",
      "effect": "candidate set",
      "limit": "SP395 constrains UN3549 to solid disposal",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 25,
      "id": "62-WASTE-B",
      "citation": "2.2.62.1.11.1(b)",
      "condition_description": "Category B clinical or medical waste ->3291",
      "evidence_requirements": "waste origin; infection Category B",
      "effect": "3291 candidate",
      "limit": "SP565 binding",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 26,
      "id": "62-WASTE-CODE-DIAG",
      "citation": "2.2.62.1.11.1 Note 2",
      "condition_description": "Waste catalogue codes 18 01 03/18 02 02 require medical/veterinary diagnosis-based classification",
      "evidence_requirements": "catalogue code, diagnosis",
      "effect": "professional judgement gate",
      "limit": "Code alone does not assign final entry",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 27,
      "id": "62-WASTE-LOW",
      "citation": "2.2.62.1.11.2",
      "condition_description": "Waste reasonably believed low probability of containing infectious substances ->3291",
      "evidence_requirements": "supported waste context and low-probability finding",
      "effect": "3291 candidate",
      "limit": "Different from no infectious",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 28,
      "id": "62-WASTE-CODE-EX",
      "citation": "2.2.62.1.11.2 Note 2",
      "condition_description": "Waste catalogue 18 01 04/18 02 03 non-subject under specified list conditions",
      "evidence_requirements": "correct source coding and verification",
      "effect": "conditional non-subject",
      "limit": "Conflicting Category A requires review",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 29,
      "id": "62-WASTE-DECONTAM",
      "citation": "2.2.62.1.11.3",
      "condition_description": "Decontaminated waste previously infectious not subject unless another class",
      "evidence_requirements": "decontamination evidence",
      "effect": "conditional non-subject",
      "limit": "Other classes unresolved",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 30,
      "id": "62-LIVE-APPROVAL",
      "citation": "2.2.62.1.12.1;2.2.62.2",
      "condition_description": "Intentionally infected live animals require competent authority controls; live-agent carriage restricted",
      "evidence_requirements": "approval, route and alternative carriage",
      "effect": "authority gate",
      "limit": "National livestock rules also relevant",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 31,
      "id": "62-LIVE-NATURAL",
      "citation": "2.2.62.1.1 Note 1",
      "condition_description": "Unintentional/natural infected live animal governed by origin, transit and destination national rules",
      "evidence_requirements": "animal infection origin; countries",
      "effect": "national rules referral",
      "limit": "Not normal UN2814/2900 automatic classification",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 32,
      "id": "62-TOXIN",
      "citation": "2.2.62.1.1 Note 2",
      "condition_description": "Plant/animal/bacterial toxins without infectious material are referred to Class 6.1 UN3172 or UN3462",
      "evidence_requirements": "absence of infectious agent and toxin evidence",
      "effect": "other class referral",
      "limit": "No final entry assignment",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 33,
      "id": "62-TABLE-A",
      "citation": "3.2.1 Table A column (1)-(8)",
      "condition_description": "Checked 2814/2900/3291/3373/3549 rows have blank PG field and entry-specific classification/SP/packing data",
      "evidence_requirements": "full Table A row, variants, special provisions",
      "effect": "mandatory integration lookup",
      "limit": "Source PDF printed pp.448,452,454,496,506,528",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 34,
      "id": "62-SP318",
      "citation": "3.3.1 SP318;3.1.2.8",
      "condition_description": "Technical name documentation; unknown but suspected Category A phrase where required",
      "evidence_requirements": "pathogen identification and shipping document",
      "effect": "documentation dependency",
      "limit": "2814/2900 only as assigned by Table A",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 35,
      "id": "62-SP319",
      "citation": "3.3.1 SP319;4.1.4.1 P650",
      "condition_description": "Other ADR requirements relief only if P650 packaging and package marking verified",
      "evidence_requirements": "verified P650 compliance and marking",
      "effect": "conditional provision relief",
      "limit": "3373 Table A",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 36,
      "id": "62-SP395",
      "citation": "3.3.1 SP395",
      "condition_description": "3549 entry only for solid Category A medical waste carried for disposal",
      "evidence_requirements": "solid and disposal proof",
      "effect": "named-entry restriction",
      "limit": "Must satisfy 2.2.62.1.11.1",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 37,
      "id": "62-SP565",
      "citation": "3.3.1 SP565",
      "condition_description": "Unspecified qualifying medical/veterinary/biological-research waste unlikely to contain Class6.2 assigned to its entry",
      "evidence_requirements": "waste origin and infectious likelihood",
      "effect": "named-entry dependency",
      "limit": "3291 Table A",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 38,
      "id": "62-SP601",
      "citation": "3.3.1 SP601",
      "condition_description": "Pharmaceutical retail-ready products provision applies only if row-bound",
      "evidence_requirements": "Table A column6 binding and product state",
      "effect": "unbound external dependency",
      "limit": "Not automatically applied to all Class6.2",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 39,
      "id": "62-CONFLICT",
      "citation": "2.2.62.1.4.1;2.2.62.1.5.8;2.2.62.1.11.1-2",
      "condition_description": "Contradictory A positive and exemption/low risk claims require expert resolution",
      "evidence_requirements": "discordant records",
      "effect": "requires expert review",
      "limit": "No override by first applicable exemption",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    },
    {
      "priority": 40,
      "id": "62-MODES",
      "citation": "2.2.62.1.5.8 Note 2;ADR title",
      "condition_description": "Road-only ADR baseline; other modes use own regulations",
      "evidence_requirements": "transport mode",
      "effect": "out of scope",
      "limit": "No combined multimodal transport output",
      "edition": "2025",
      "document": "ECE/TRANS/352 Vol.I"
    }
  ],
  "numeric_conditions": [
    {
      "id": "62-MINIMAL-PACK",
      "predicate": "outer_width_mm >= 100 AND outer_height_mm >= 100",
      "unit": "mm",
      "citation": "2.2.62.1.5.8(a)(iii)"
    },
    {
      "id": "62-DEVICE",
      "predicate": "device_packaging.drop_height_m >= 1.2 AND retains_on_1_2m_drop === true",
      "unit": "m",
      "citation": "2.2.62.1.5.9"
    }
  ],
  "information_states": [
    "positive",
    "verified_negative_class62_or_specific_exception",
    "unknown",
    "incomplete",
    "unresolved_category_a",
    "packaging_unproven",
    "contradictory_evidence",
    "authority_gate_unresolved"
  ],
  "final_assignment_never_permitted": true
}
