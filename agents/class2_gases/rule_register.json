  "special_method_notes": [
    {
      "clause": "2.2.2.1.5",
      "note": "For toxic-gas mixtures, component Ti uses P200 value first, otherwise defensible literature, analogue or testing."
    },
    {
      "clause": "2.2.2.1.6(c)",
      "note": "ADR prescribes specific heat-of-combustion methods. MTC Rev.8 Amend.1 broadens 31.3.3; do not silently substitute amended MTC method for ADR wording."
    },
    {
      "clause": "2.2.2.1.3 Note 1",
      "note": "2.1/2.2/2.3 is informational division_hint (Model Regulations/IMDG/ICAO); ADR result remains Class 2 and group."
    },
    {
      "clause": "3.2.1 Table A",
      "note": "No final UN/packing group/subsidiary label without selected row, all special provisions and review."
    }
  ],
